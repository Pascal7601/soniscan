[importlinter]
root_packages =
    scanner
    apps
    config
include_external_packages = True

[importlinter:contract:scanner-is-framework-free]
name = The scanner package must not depend on Django, DRF or application code
type = forbidden
source_modules =
    scanner
forbidden_modules =
    django
    rest_framework
    apps
    config
    celery

[importlinter:contract:app-layers]
name = Apps form layers: a lower app never imports a higher one
type = layers
layers =
    apps.findings
    apps.scans
    apps.domains
    apps.accounts
    apps.core
