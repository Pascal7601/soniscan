[importlinter]
root_packages =
    scanner
    apps
    config
include_external_packages = True

[importlinter:contract:scanner-is-framework-free]
name = The scanner package must not depend on Django, DRF or application code
type = forbidden
source_modules =
    scanner
forbidden_modules =
    django
    rest_framework
    apps
    config
    celery

[importlinter:contract:core-is-the-lowest-layer]
name = apps.core must not depend on other apps
type = forbidden
source_modules =
    apps.core
forbidden_modules =
    apps.accounts
    apps.domains
    apps.scans
