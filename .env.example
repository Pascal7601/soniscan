# Copy to .env (never commit .env)
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-local-only
# Runtime connection: least-privilege role, subject to row-level security
DATABASE_URL=postgres://app_api:app_api_dev@localhost:5432/posture
# Migration connection: owner role, used only by `make migrate`
MIGRATE_DATABASE_URL=postgres://app_owner:app_owner_dev@localhost:5432/posture
REDIS_URL=redis://localhost:6379/0

# Worker connection: its own least-privilege role (used by `make worker`)
WORKER_DATABASE_URL=postgres://scanner_worker:scanner_worker_dev@localhost:5432/posture
# Optional: pin DNS resolvers for scans (comma separated) and the resolver health canary
# SCANNER_DNS_SERVERS=1.1.1.1,9.9.9.9
# SCANNER_DNS_CANARY=a.root-servers.net